# Copy to .env and set your upstream proxy endpoint (plain, unquoted values).
# Upstream settings are optional only when a configured domain file is empty.
# Credentials are prompted for by startup.sh; do not store them here.
UPSTREAM_SQUID_HOST=proxy.example.com
UPSTREAM_SQUID_PORT=3128
# auto prefers OrbStack (when its Docker context exists), then Docker, then Podman.
# Options: auto, podman, docker, orbstack (Docker's orbstack context).
CONTAINER_RUNTIME=auto
# Optional: copy proxy-domains.txt.sample to proxy-domains.txt, then uncomment.
# Unconfigured = all via Squid; listed = via Squid; unlisted = direct.
# An empty file = all direct, with no upstream settings or credentials required.
# PROXY_DOMAINS_FILE=proxy-domains.txt
